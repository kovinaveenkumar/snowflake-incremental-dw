# Copy to .env and fill in. Never commit .env.

# Snowflake (trial account). Key-pair auth; the private key lives outside the repo.
SNOWFLAKE_ACCOUNT=            # account identifier, e.g. ORGNAME-ACCTNAME
SNOWFLAKE_USER=               # your Snowflake login name
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/keys/dw_rsa_key.p8
SNOWFLAKE_ROLE=ACCOUNTADMIN   # setup only; later steps use the project role DW_ROLE
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=BROKER_DW

# Oracle 23ai Free (Docker: gvenzl/oracle-free), used in Step 12
ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_USER=
ORACLE_PASSWORD=
